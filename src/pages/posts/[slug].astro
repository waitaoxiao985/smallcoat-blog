---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const dayNumber = Number(post.id.slice(4));
const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const previousPost = allPosts.find((entry) => entry.id === `day-${String(dayNumber - 1).padStart(3, '0')}`);
const nextPost = allPosts.find((entry) => entry.id === `day-${String(dayNumber + 1).padStart(3, '0')}`);
const weekTag = post.data.tags.find((tag) => tag.startsWith('Week ')) ?? 'Week 1';
const weekNumber = Number(weekTag.replace('Week ', '')) || 1;
const weekLabels = ['破冰与实验环境', '信息搜集与侦察', '注入风险与验证', '客户端与服务端安全'];
---
<BaseLayout title={`${post.data.title} — SmalLCoat`} description={post.data.description}>
  <main class="post-page">
    <article class="container post-container">
      <a class="text-link back-link" href="/#articles">← 返回学习记录</a>
      <header class="post-header">
        <div class="post-kicker">DAY {String(dayNumber).padStart(2, '0')} <span>·</span> WEEK 0{weekNumber} / {weekLabels[weekNumber - 1]}</div>
        <h1>{post.data.title}</h1>
        <p class="post-description">{post.data.description}</p>
        <div class="post-tags">{post.data.tags.filter((tag) => !tag.startsWith('Week ')).map((tag) => <span>{tag}</span>)}</div>
      </header>
      <div class="article-body"><Content /></div>
      <nav class="post-navigation" aria-label="文章导航">
        {previousPost ? <a class="post-nav-card" href={`/posts/${previousPost.id}/`}><span>← 上一篇 · DAY {String(dayNumber - 1).padStart(2, '0')}</span><strong>{previousPost.data.title}</strong></a> : <span></span>}
        {nextPost ? <a class="post-nav-card next" href={`/posts/${nextPost.id}/`}><span>下一篇 · DAY {String(dayNumber + 1).padStart(2, '0')} →</span><strong>{nextPost.data.title}</strong></a> : <a class="post-nav-card next" href="/#articles"><span>系列完成</span><strong>返回全部学习记录 ↗</strong></a>}
      </nav>
    </article>
  </main>
  <style>
    .post-page { min-height: 80vh; padding: 112px 0 90px; }
    .post-container { max-width: 820px; }
    .back-link { display: inline-flex; margin-bottom: 46px; }
    .post-header { padding-bottom: 32px; border-bottom: 1px solid var(--line); }
    .post-kicker { color: var(--cyan); font: 11px var(--mono); letter-spacing: .1em; }
    .post-kicker span { padding: 0 7px; color: var(--subtle); }
    .post-header h1 { margin: 20px 0 14px; color: var(--text); font-size: clamp(34px, 6vw, 56px); line-height: 1.24; letter-spacing: -.055em; }
    .post-description { margin: 0; color: var(--muted); font-size: 16px; line-height: 1.85; }
    .post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 21px; }
    .post-tags span { padding: 6px 9px; border: 1px solid var(--line); border-radius: 4px; color: #a5b8c8; font: 10px var(--mono); }
    .article-body { max-width: 740px; margin: 38px auto 0; color: #c0ccd7; font-size: 16px; line-height: 1.95; overflow-wrap: anywhere; }
    .article-body :global(h2) { margin: 2.4em 0 .8em; padding-bottom: .45em; border-bottom: 1px solid var(--line); color: var(--text); font-size: 25px; line-height: 1.4; letter-spacing: -.035em; }
    .article-body :global(h3) { margin: 2em 0 .65em; color: #dbe8f1; font-size: 19px; letter-spacing: -.02em; }
    .article-body :global(p) { margin: 1em 0; }
    .article-body :global(a) { color: var(--cyan); text-decoration: underline; text-underline-offset: 3px; }
    .article-body :global(ul), .article-body :global(ol) { padding-left: 1.5em; }
    .article-body :global(li) { padding-left: .25em; margin: .4em 0; }
    .article-body :global(blockquote) { margin: 1.5em 0; padding: 12px 18px; border-left: 2px solid var(--cyan); background: rgba(86,217,245,.045); color: #b7cad8; }
    .article-body :global(blockquote p:first-child) { margin-top: 0; }
    .article-body :global(blockquote p:last-child) { margin-bottom: 0; }
    .article-body :global(table) { display: block; width: 100%; margin: 1.6em 0; overflow-x: auto; border-collapse: collapse; font-size: 14px; }
    .article-body :global(th), .article-body :global(td) { min-width: 100px; padding: 10px 12px; border: 1px solid var(--line); text-align: left; }
    .article-body :global(th) { background: var(--panel-soft); color: var(--text); }
    .article-body :global(pre) { overflow-x: auto; margin: 1.5em 0; padding: 18px 20px; border: 1px solid var(--line); border-radius: 7px; background: #191030; font: 13px/1.75 var(--mono); }
    .article-body :global(code) { font-family: var(--mono); font-size: .9em; }
    .article-body :global(:not(pre) > code) { padding: 2px 5px; border-radius: 3px; background: rgba(148,182,210,.1); color: #a9eafa; }
    .article-body :global(img) { display: block; max-width: 100%; height: auto; margin: 1.5em auto; border: 1px solid var(--line); border-radius: 7px; }
    .post-navigation { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 55px; padding-top: 22px; border-top: 1px solid var(--line); }
    .post-nav-card { display: flex; min-height: 88px; flex-direction: column; justify-content: center; gap: 8px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 6px; }
    .post-nav-card:hover { border-color: rgba(86,217,245,.45); }
    .post-nav-card span { color: var(--cyan); font: 10px var(--mono); }
    .post-nav-card strong { color: var(--text); font-size: 13px; line-height: 1.6; }
    .post-nav-card.next { text-align: right; }
    @media (max-width: 600px) { .post-page { padding-top: 90px; } .back-link { margin-bottom: 32px; } .article-body { font-size: 15px; } .post-navigation { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
