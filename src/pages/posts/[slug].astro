---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import PostToc from '../../components/PostToc.astro';
import ImageLightbox from '../../components/ImageLightbox.astro';
import BackToTop from '../../components/BackToTop.astro';
import {
  estimateReadingStats,
  formatDate,
  formatDayLabel,
  getAdjacentPosts,
  getPostWeek,
  getPublishedPosts,
  getSameWeekPosts,
  getTopicTags,
  parseDayNumber,
  tagToSlug,
} from '../../lib/posts';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('asc');
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const allPosts = await getPublishedPosts('asc');
const dayNumber = parseDayNumber(post.id);
const dayLabel = formatDayLabel(post.id);
const weekMeta = getPostWeek(post);
const topicTags = getTopicTags(post);
const stats = estimateReadingStats(post.body);
const { previousPost, nextPost } = getAdjacentPosts(allPosts, post.id);
const sameWeekPosts = getSameWeekPosts(allPosts, post);
const publishedDate = formatDate(post.data.pubDate);

const postUrl = new URL(`/posts/${post.id}/`, SITE.url).href;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: post.data.title,
    description: post.data.description,
    datePublished: post.data.pubDate.toISOString(),
    author: { '@type': 'Person', name: SITE.author, url: SITE.github },
    publisher: { '@type': 'Person', name: SITE.name },
    keywords: topicTags.join(', '),
    mainEntityOfPage: postUrl,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: '首页', item: SITE.url },
      { '@type': 'ListItem', position: 2, name: '学习记录', item: `${SITE.url}/#articles` },
      { '@type': 'ListItem', position: 3, name: post.data.title, item: postUrl },
    ],
  },
];
---
<BaseLayout
  title={`${post.data.title} — ${SITE.name}`}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate.toISOString()}
  tags={topicTags}
  jsonLd={jsonLd}
>
  <SiteHeader active="articles" showProgress={true} />

  <main
    class="post-page"
    id="main-content"
    data-post-slug={post.id}
    data-post-title={post.data.title}
    data-post-day={dayLabel}
  >
    <div class="container post-layout">
      <article class="post-container">
        <a class="text-link back-link" href="/#articles">← 返回学习记录</a>
        <header class="post-header">
          <div class="post-kicker">
            {dayNumber !== null ? dayLabel : 'ARTICLE'}
            <span>·</span>
            {weekMeta ? `WEEK 0${weekMeta.week} / ${weekMeta.label}` : '技术笔记'}
          </div>
          <h1>{post.data.title}</h1>
          <p class="post-description">{post.data.description}</p>
          <div class="post-meta">
            <span>发布于 <time datetime={post.data.pubDate.toISOString()}>{publishedDate}</time></span>
            <span>·</span>
            <span>约 {stats.minutes} 分钟阅读</span>
            <span>·</span>
            <span>{stats.wordCount.toLocaleString('zh-CN')} 字</span>
            {stats.imageCount > 0 && (
              <>
                <span>·</span>
                <span>{stats.imageCount} 张实战截图</span>
              </>
            )}
          </div>
          {topicTags.length > 0 && (
            <div class="post-tags" aria-label="文章标签">
              {topicTags.map((tag) => (
                <a class="post-tag-link" href={`/tags/${tagToSlug(tag)}/`}>#{tag}</a>
              ))}
            </div>
          )}
        </header>

        <PostToc headings={headings} variant="mobile" />

        <div class="article-body"><Content /></div>

        {weekMeta && sameWeekPosts.length > 1 && (
          <section class="week-path" aria-label="同周学习路径">
            <div class="week-path-head">
              <span class="week-path-kicker">WEEK 0{weekMeta.week} · {weekMeta.label}</span>
              <span class="week-path-count">共 {sameWeekPosts.length} 篇</span>
            </div>
            <div class="week-path-list">
              {sameWeekPosts.map((entry) => {
                const isCurrent = entry.id === post.id;
                return (
                  <a
                    class={`week-path-item ${isCurrent ? 'is-current' : ''}`}
                    href={`/posts/${entry.id}/`}
                    aria-current={isCurrent ? 'page' : undefined}
                  >
                    <span class="wp-day">{formatDayLabel(entry.id)}</span>
                    <span class="wp-title">{entry.data.title}</span>
                  </a>
                );
              })}
            </div>
          </section>
        )}

        <nav class="post-navigation" aria-label="文章导航">
          {previousPost ? (
            <a class="post-nav-card" href={`/posts/${previousPost.id}/`}>
              <span>← 上一篇 · {formatDayLabel(previousPost.id)}</span>
              <strong>{previousPost.data.title}</strong>
            </a>
          ) : (
            <span></span>
          )}
          {nextPost ? (
            <a class="post-nav-card next" href={`/posts/${nextPost.id}/`}>
              <span>下一篇 · {formatDayLabel(nextPost.id)} →</span>
              <strong>{nextPost.data.title}</strong>
            </a>
          ) : (
            <a class="post-nav-card next" href="/#articles">
              <span>系列完成</span>
              <strong>返回全部学习记录 ↗</strong>
            </a>
          )}
        </nav>
      </article>

      <PostToc headings={headings} variant="desktop" />
    </div>
  </main>

  <ImageLightbox />
  <SiteFooter />
  <BackToTop />

  <style>
    .post-page { min-height: 80vh; padding: 54px 0 90px; }
    .post-layout {
      display: grid;
      grid-template-columns: minmax(0, 780px) 240px;
      justify-content: center;
      gap: 48px;
      align-items: start;
    }
    .post-container { min-width: 0; }
    .back-link { display: inline-flex; margin-bottom: 34px; }
    .post-header { padding-bottom: 28px; border-bottom: 1px solid var(--line); }
    .post-kicker { color: var(--cyan); font: 11px var(--mono); letter-spacing: .1em; }
    .post-kicker span { padding: 0 7px; color: var(--subtle); }
    .post-header h1 { margin: 18px 0 14px; color: var(--text); font-size: clamp(32px, 5vw, 50px); line-height: 1.24; letter-spacing: -.05em; }
    .post-description { margin: 0; color: var(--muted); font-size: 16px; line-height: 1.85; }
    .post-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 10px;
      margin-top: 18px;
      color: var(--subtle);
      font: 11.5px var(--mono);
    }
    .post-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 18px; }
    .post-tag-link {
      display: inline-flex;
      align-items: center;
      min-height: 32px;
      padding: 4px 10px;
      border: 1px solid var(--line);
      border-radius: 4px;
      color: #a5b8c8;
      font: 11px var(--mono);
      transition: color .18s, border-color .18s, background .18s;
    }
    .post-tag-link:hover {
      color: var(--cyan);
      border-color: rgba(86, 217, 245, .5);
      background: rgba(86, 217, 245, .07);
    }
    .post-tag-link:focus-visible,
    .week-path-item:focus-visible,
    .post-nav-card:focus-visible {
      outline: 2px solid var(--cyan);
      outline-offset: 2px;
    }

    .article-body { margin-top: 34px; color: #c0ccd7; font-size: 16px; line-height: 1.95; overflow-wrap: anywhere; }
    .article-body :global(h2) {
      position: relative;
      margin: 2.3em 0 .8em;
      padding-bottom: .45em;
      border-bottom: 1px solid var(--line);
      color: var(--text);
      font-size: 24px;
      line-height: 1.4;
      letter-spacing: -.035em;
      scroll-margin-top: 80px;
    }
    .article-body :global(h3) {
      position: relative;
      margin: 1.9em 0 .65em;
      color: #dbe8f1;
      font-size: 19px;
      letter-spacing: -.02em;
      scroll-margin-top: 80px;
    }
    .article-body :global(h4) { scroll-margin-top: 80px; }
    .article-body :global(p) { margin: 1em 0; }
    .article-body :global(a) { color: var(--cyan); text-decoration: underline; text-underline-offset: 3px; }
    .article-body :global(ul), .article-body :global(ol) { padding-left: 1.5em; }
    .article-body :global(li) { padding-left: .25em; margin: .4em 0; }
    .article-body :global(blockquote) { margin: 1.5em 0; padding: 12px 18px; border-left: 2px solid var(--cyan); background: rgba(86,217,245,.045); color: #b7cad8; }
    .article-body :global(blockquote p:first-child) { margin-top: 0; }
    .article-body :global(blockquote p:last-child) { margin-bottom: 0; }
    .article-body :global(table) { display: block; width: 100%; margin: 1.6em 0; overflow-x: auto; border-collapse: collapse; font-size: 14px; }
    .article-body :global(th), .article-body :global(td) { min-width: 100px; padding: 10px 12px; border: 1px solid var(--line); text-align: left; }
    .article-body :global(th) { background: var(--panel-soft); color: var(--text); }
    .article-body :global(pre) { position: relative; overflow-x: auto; margin: 1.5em 0; padding: 18px 20px; border: 1px solid var(--line); border-radius: 7px; font: 13px/1.75 var(--mono); }
    .article-body :global(pre.astro-code) { background-color: #1a1b26 !important; }
    .article-body :global(code) { font-family: var(--mono); font-size: .9em; }
    .article-body :global(:not(pre) > code) { padding: 2px 5px; border-radius: 3px; background: rgba(148,182,210,.1); color: #a9eafa; }
    .article-body :global(.article-figure) { margin: 1.7em 0; }
    .article-body :global(.article-figure img),
    .article-body :global(img) { display: block; max-width: 100%; height: auto; margin: 0 auto; border: 1px solid var(--line); border-radius: 7px; }
    .article-body :global(.article-figure figcaption) {
      margin-top: 9px;
      color: var(--subtle);
      font: 12px/1.6 var(--sans);
      text-align: center;
    }

    .week-path {
      margin-top: 48px;
      padding: 18px 20px;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: rgba(28, 18, 51, .4);
    }
    .week-path-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 12px;
    }
    .week-path-kicker { color: var(--cyan); font: 500 11px var(--mono); letter-spacing: .08em; }
    .week-path-count { color: var(--subtle); font: 11px var(--mono); }
    .week-path-list {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
      gap: 8px;
    }
    .week-path-item {
      display: flex;
      align-items: center;
      gap: 9px;
      min-width: 0;
      padding: 9px 11px;
      border: 1px solid rgba(183, 168, 226, .12);
      border-radius: 6px;
      font-size: 12.5px;
      color: var(--muted);
      transition: border-color .16s, color .16s, background .16s;
    }
    .week-path-item:hover {
      border-color: rgba(86, 217, 245, .4);
      color: var(--text);
    }
    .week-path-item.is-current {
      border-color: rgba(86, 217, 245, .55);
      background: rgba(86, 217, 245, .08);
      color: var(--text);
    }
    .wp-day { flex-shrink: 0; color: var(--cyan); font: 10px var(--mono); }
    .wp-title { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

    .post-navigation { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 32px; padding-top: 22px; border-top: 1px solid var(--line); }
    .post-nav-card { display: flex; min-height: 88px; flex-direction: column; justify-content: center; gap: 8px; padding: 14px 16px; border: 1px solid var(--line); border-radius: 6px; transition: border-color .18s; }
    .post-nav-card:hover { border-color: rgba(86,217,245,.45); }
    .post-nav-card span { color: var(--cyan); font: 10px var(--mono); }
    .post-nav-card strong { color: var(--text); font-size: 13px; line-height: 1.6; }
    .post-nav-card.next { text-align: right; }

    @media (max-width: 1179px) {
      .post-layout { grid-template-columns: minmax(0, 780px); }
    }
    @media (max-width: 700px) {
      .post-page { padding-top: 32px; }
      .back-link { margin-bottom: 24px; }
      .article-body { font-size: 15px; }
      .post-navigation { grid-template-columns: 1fr; }
    }
  </style>

  <style is:global>
    /* 代码块头部栏与复制按钮、标题锚点均由脚本增强生成，需全局作用域样式 */
    .code-frame {
      margin: 1.5em 0;
      border: 1px solid var(--line);
      border-radius: 8px;
      overflow: hidden;
      background: #1a1b26;
    }
    .code-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 6px 12px;
      border-bottom: 1px solid rgba(183, 168, 226, .12);
      background: rgba(21, 13, 38, .85);
    }
    .code-lang {
      color: var(--subtle);
      font: 500 10px var(--mono);
      letter-spacing: .12em;
      text-transform: uppercase;
    }
    .article-body .code-frame pre {
      margin: 0;
      border: 0;
      border-radius: 0;
    }
    .copy-btn {
      min-height: 28px;
      padding: 3px 10px;
      border: 1px solid var(--line);
      border-radius: 4px;
      background: rgba(28, 18, 51, .8);
      color: var(--muted);
      font: 500 10px var(--mono);
      letter-spacing: .06em;
      cursor: pointer;
      transition: color .18s, border-color .18s, background .18s;
    }
    .copy-btn:hover { color: var(--cyan); border-color: rgba(86, 217, 245, .45); }
    .copy-btn:focus-visible { outline: 2px solid var(--cyan); outline-offset: 2px; }
    .copy-btn.copied { color: #7ee2a8; border-color: rgba(126, 226, 168, .45); }

    .article-body .heading-anchor {
      margin-left: 8px;
      color: var(--subtle);
      font: 500 .8em var(--mono);
      text-decoration: none;
      opacity: 0;
      transition: opacity .16s, color .16s;
    }
    .article-body h2:hover .heading-anchor,
    .article-body h3:hover .heading-anchor,
    .article-body .heading-anchor:focus-visible {
      opacity: 1;
      color: var(--cyan);
    }
  </style>

  <script>
    // 1. 增强代码块：包裹语言头栏 + 常驻复制按钮（移动端也可直接点击，横向滚动不漂移）。
    const blocks = document.querySelectorAll<HTMLPreElement>('.article-body pre');
    blocks.forEach((pre) => {
      if (pre.parentElement?.classList.contains('code-frame')) return;
      const frame = document.createElement('div');
      frame.className = 'code-frame';

      const header = document.createElement('div');
      header.className = 'code-header';

      const langLabel = document.createElement('span');
      langLabel.className = 'code-lang';
      const rawLang = pre.dataset.language || 'text';
      langLabel.textContent = rawLang === 'plaintext' ? 'TEXT' : rawLang.toUpperCase();

      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-btn';
      button.setAttribute('aria-label', '复制代码');
      button.textContent = '复制';
      button.addEventListener('click', async () => {
        const codeEl = pre.querySelector<HTMLElement>('code');
        const text = codeEl?.innerText ?? pre.innerText ?? pre.textContent ?? '';
        try {
          await navigator.clipboard.writeText(text);
          button.textContent = '已复制 ✓';
          button.classList.add('copied');
        } catch {
          button.textContent = '复制失败';
        }
        window.setTimeout(() => {
          button.textContent = '复制';
          button.classList.remove('copied');
        }, 1600);
      });

      header.append(langLabel, button);
      pre.parentNode?.insertBefore(frame, pre);
      frame.append(header, pre);
    });

    // 2. 为二级/三级标题追加温和的章节锚点。
    document.querySelectorAll<HTMLElement>('.article-body h2[id], .article-body h3[id]').forEach((heading) => {
      if (heading.querySelector('.heading-anchor')) return;
      const anchor = document.createElement('a');
      anchor.className = 'heading-anchor';
      anchor.href = `#${heading.id}`;
      anchor.setAttribute('aria-label', `跳转到章节：${heading.textContent?.trim() ?? ''}`);
      anchor.textContent = '#';
      heading.appendChild(anchor);
    });

    // 3. 记录最近阅读文章到 localStorage，供首页学习记录区显示「继续阅读」。
    const mainEl = document.querySelector<HTMLElement>('[data-post-slug]');
    if (mainEl) {
      try {
        localStorage.setItem(
          'sc:last-read',
          JSON.stringify({
            slug: mainEl.dataset.postSlug,
            title: mainEl.dataset.postTitle,
            dayLabel: mainEl.dataset.postDay,
            savedAt: Date.now(),
          }),
        );
      } catch {
        // 隐私模式或禁用存储时静默忽略。
      }
    }
  </script>
</BaseLayout>
