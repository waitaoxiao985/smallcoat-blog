---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSpotlight from '../components/HeroSpotlight.astro';
import TechIllustration from '../components/TechIllustration.astro';
import HubController from '../components/HubController.astro';
import CinematicScroll from '../components/CinematicScroll.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import ArticlesAccordion from '../components/ArticlesAccordion.astro';
import DecodeBar from '../components/DecodeBar.astro';
import WhoamiTerminal from '../components/WhoamiTerminal.astro';
import { getCollection } from 'astro:content';
import '../styles/hub.css';
import '../styles/widgets.css';

const projects = [
  { name: 'SecGuard', description: '轻量级主机安全监控平台，探索 SIEM / XDR 的实践。', tech: 'JAVA · SECURITY', href: 'https://github.com/waitaoxiao985/SecGuard', number: '01' },
  { name: 'Cyber_Platform', description: '自建 CTF 题库网站，记录平台构建与安全学习。', tech: 'TYPESCRIPT · CTF', href: 'https://github.com/waitaoxiao985/Cyber_Platform', number: '02' },
  { name: 'CyberSpace_Notes', description: '持续整理网络空间安全方向的学习笔记。', tech: 'NOTES · SECURITY', href: 'https://github.com/waitaoxiao985/CyberSpace_Notes', number: '03' },
];
const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort((a, b) => a.id.localeCompare(b.id));
const weeks = [1, 2, 3, 4].map((week) => ({
  week,
  label: ['破冰与实验环境', '信息搜集与侦察', '注入风险与验证', '客户端与服务端安全'][week - 1],
  posts: posts.filter((post) => post.data.tags.includes(`Week ${week}`)),
}));
const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>';
const entries = [
  { id: 'projects', num: '01', name: '项目', caption: `SELECTED WORK · 0${projects.length}` },
  { id: 'articles', num: '02', name: '学习记录', caption: `LEARNING LOG · ${posts.length}` },
  { id: 'about', num: '03', name: '关于我', caption: 'ABOUT · BIO' },
];
---
<BaseLayout>
  <noscript><style>.hub-panel[hidden]{display:block!important}.panel-bar{display:none!important}.site-footer{display:block!important}</style></noscript>

  <div class="hub-shell" id="top">
    <section class="hub" aria-labelledby="hub-title">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="hero-glow" aria-hidden="true"></div>
      <HeroSpotlight />
      <div class="hub-inner container">
        <div class="hub-brand"><span class="brand-mark">SC</span><span>SmalLCoat</span><span class="hub-brand-tag">ENTRY / 00</span></div>
        <div class="hub-copy">
          <div class="eyebrow">个人技术博客 · NETWORK & CODE</div>
          <h1 id="hub-title" tabindex="-1">SmalL<span>Coat</span></h1>
          <p class="hub-tagline">以代码为笔，探索技术的无限可能。<br /><strong>记录编程实践，也记录网络安全学习的每一步。</strong></p>
          <nav class="hub-nav" aria-label="选择板块">
            {entries.map((entry) => (
              <a class="hub-entry" href={`#${entry.id}`} data-hub-link={entry.id}>
                <span class="hub-entry-num">{entry.num}</span>
                <span class="hub-entry-body"><strong>{entry.name}</strong><small>{entry.caption}</small></span>
                <span class="hub-entry-arrow">→</span>
              </a>
            ))}
            <a class="hub-entry" href="https://github.com/waitaoxiao985" target="_blank" rel="noreferrer">
              <span class="hub-entry-num">04</span>
              <span class="hub-entry-body"><strong>GitHub</strong><small>OPEN SOURCE · @waitaoxiao985</small></span>
              <span class="hub-entry-arrow">↗</span>
            </a>
          </nav>
          <p class="hub-hint">选择板块进入 · 按 ESC 返回入口</p>
        </div>
        <div class="hub-art"><TechIllustration /></div>
      </div>
    </section>
  </div>

  <div class="panel-bar" hidden>
    <div class="panel-bar-inner container">
      <button type="button" class="panel-back">← 返回入口</button>
      <span class="panel-label" aria-live="polite"></span>
      <a class="panel-gh" href="https://github.com/waitaoxiao985" target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
  </div>

  <div class="hub-panels">
    <section class="section hub-panel" id="projects" data-hub-panel="projects" data-hub-label="项目" hidden tabindex="-1" aria-label="项目">
      <div class="projects-stage">
        <div class="container">
          <div class="section-heading"><div><div class="section-kicker">Selected work / 01—03</div><h2 class="section-title">正在构建的东西</h2></div><div class="section-note">一些实践，也是一段段学习记录。</div></div>
          <div class="build-log" aria-hidden="true"><span class="build-log-tag">BUILD LOG</span><div class="build-log-screen"><span class="build-log-line">$ ./build.sh SecGuard --target=host</span><span class="build-log-line">[OK] SIEM 规则引擎编译通过 · 2.4s</span><span class="build-log-line">$ ./deploy.sh Cyber_Platform --env=prod</span><span class="build-log-line">[OK] CTF 平台题目同步完成 · 128/128</span><span class="build-log-line">$ ./scan.sh --daily --site=smallcoat.blog</span><span class="build-log-line">[OK] 未发现漏洞 · 继续挖洞学习</span></div></div>
          <div class="project-list">
            {projects.map((project) => (
              <a class="project" href={project.href} target="_blank" rel="noreferrer">
                <div class="project-top"><span>PROJECT / {project.number}</span><span class="project-symbol">↗</span></div>
                <h3 class="project-title">{project.name}</h3>
                <p class="project-desc">{project.description}</p>
                <span class="project-tag">{project.tech}</span>
                <span class="project-open">查看 GitHub 项目 ↗</span>
                <span class="project-arrow" set:html={arrow} />
              </a>
            ))}
          </div>
          <nav class="project-controls" aria-label="项目场景切换">
            <span class="project-position" aria-hidden="true">01 / 03</span>
            {projects.map((project, index) => <button type="button" data-project-index={index} aria-label={`展示项目 ${index + 1}`}><span>{project.number}</span> {project.name}</button>)}
            <a href="#about" class="skip-stage" data-hub-link="about">跳过展示 →</a>
          </nav>
        </div>
      </div>
    </section>

    <section class="section hub-panel" id="articles" data-hub-panel="articles" data-hub-label="学习记录" hidden tabindex="-1" aria-label="学习记录">
      <div class="container">
        <div class="section-heading"><div><div class="section-kicker">Learning log / Day 01—28</div><h2 class="section-title"><button type="button" class="title-toggle" data-articles-gate aria-controls="week-list">网络安全实战学习记录</button></h2></div><div class="section-note">点击标题展开周目录 · 4 周 · {posts.length} 篇</div></div>
        <div class="decode-bar" aria-hidden="true"><span class="decode-prefix">&gt; DECRYPT</span><span class="decode-text" data-decode-text>LEARNING LOG · 28 FILES · 4 WEEKS · ACCESS GRANTED</span></div>
        <div class="week-list" id="week-list" data-articles-weeks>
          {weeks.map((group) => <section class="week-group" aria-labelledby={`week-${group.week}`}>
            <div class="week-heading"><span class="week-number">WEEK / 0{group.week}</span><h3 id={`week-${group.week}`}><button type="button" class="week-toggle" data-week-toggle aria-controls={`week-articles-${group.week}`}>{group.label}</button></h3><span class="week-count">{String(group.posts.length).padStart(2, '0')} 篇</span></div>
            <div class="article-list" id={`week-articles-${group.week}`} data-week-articles>
              {group.posts.map((post) => <a class="article-row" href={`/posts/${post.id}/`}><span class="article-day">{post.id.replace('day-', 'DAY ')}</span><span class="article-main"><strong>{post.data.title}</strong><small>{post.data.description}</small></span><span class="article-arrow">↗</span></a>)}
            </div>
          </section>)}
        </div>
      </div>
    </section>

    <section class="section hub-panel" id="about" data-hub-panel="about" data-hub-label="关于我" hidden tabindex="-1" aria-label="关于我">
      <div class="container about">
        <div><div class="section-kicker">About / 你好</div><h2 class="about-title">关于我</h2>
          <div class="whoami-term" data-whoami aria-hidden="true">
            <div class="whoami-bar"><span class="whoami-dot"></span><span class="whoami-dot"></span><span class="whoami-dot"></span><span class="whoami-title">whoami — zsh</span></div>
            <div class="whoami-body">
              <p data-line><span class="whoami-prompt">$</span><span class="whoami-typed">whoami</span></p>
              <p data-line><span class="whoami-typed">SmalLCoat · 网络空间安全专业在读</span></p>
              <p data-line><span class="whoami-prompt">$</span><span class="whoami-typed">cat focus.txt</span></p>
              <p data-line><span class="whoami-typed">Python 深入中 · Web 安全 · CTF</span></p>
              <p data-line><span class="whoami-prompt">$</span><span class="whoami-typed">./status --now</span></p>
              <p data-line><span class="whoami-typed">[OK] 学习进度 Day 28 / ∞ · 保持好奇</span></p>
            </div>
          </div>
        </div>
        <div class="about-copy">
          <p>你好，我是 <strong>SmalLCoat</strong>，一名网络空间安全专业的大学生。</p>
          <p>学习过 C、Java、PHP 和 Python，目前正在深入学习 Python。我会在这里记录编程实践与学习心得，分享网络安全方向的探索与成长。</p>
          <div class="about-links"><a class="text-link" href="https://github.com/waitaoxiao985" target="_blank" rel="noreferrer">GITHUB / @waitaoxiao985 ↗</a></div>
        </div>
      </div>
    </section>
  </div>

  <footer class="site-footer"><div class="container footer-inner"><span>© {new Date().getFullYear()} SmalLCoat. Built with Astro.</span><span class="footer-mark">STAY CURIOUS · KEEP BUILDING</span></div></footer>
  <CinematicScroll />
  <ScrollReveal />
  <ArticlesAccordion />
  <DecodeBar />
  <WhoamiTerminal />
  <HubController />
</BaseLayout>
