---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroSpotlight from '../components/HeroSpotlight.astro';
import TechIllustration from '../components/TechIllustration.astro';
import ArticlesFilter from '../components/ArticlesFilter.astro';
import ArticleSearch from '../components/ArticleSearch.astro';
import CinematicScroll from '../components/CinematicScroll.astro';
import ScrollReveal from '../components/ScrollReveal.astro';
import ArticlesAccordion from '../components/ArticlesAccordion.astro';
import HubController from '../components/HubController.astro';
import DecodeBar from '../components/DecodeBar.astro';
import WhoamiTerminal from '../components/WhoamiTerminal.astro';
import SiteFooter from '../components/SiteFooter.astro';
import BackToTop from '../components/BackToTop.astro';
import {
  estimateReadingStats,
  formatDayLabel,
  getAllTags,
  getPublishedPosts,
  getWeekGroups,
} from '../lib/posts';
import { ABOUT_SKILLS, PROJECTS, SITE, WEEK_META } from '../lib/site';
import '../styles/hub.css';
import '../styles/widgets.css';

const posts = await getPublishedPosts('asc');
const { groups } = getWeekGroups(posts);
const activeWeeks = groups.filter((group) => group.posts.length > 0);
const allTags = getAllTags(posts);

const statsById = new Map(posts.map((post) => [post.id, estimateReadingStats(post.body)]));
const totalWords = [...statsById.values()].reduce((sum, item) => sum + item.wordCount, 0);
const totalImages = [...statsById.values()].reduce((sum, item) => sum + item.imageCount, 0);
const latestPost = posts[posts.length - 1];

const arrow = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M7 17 17 7M7 7h10v10"/></svg>';
const entries = [
  { id: 'projects', num: '01', name: '项目', caption: `SELECTED WORK · 0${PROJECTS.length}` },
  { id: 'articles', num: '02', name: '学习记录', caption: `LEARNING LOG · ${posts.length}` },
  { id: 'about', num: '03', name: '关于我', caption: 'ABOUT · BIO' },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name,
    url: SITE.url,
    description: SITE.description,
    inLanguage: 'zh-CN',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: SITE.author,
    url: SITE.url,
    sameAs: [SITE.github],
  },
];
---
<BaseLayout jsonLd={jsonLd}>
  <noscript><style>.hub-panel[hidden]{display:block!important}.panel-bar{display:none!important}.site-footer{display:block!important}</style></noscript>

  <div class="panel-bar" hidden>
    <div class="panel-bar-inner container">
      <button type="button" class="panel-back">← 返回入口</button>
      <span class="panel-label" aria-live="polite"></span>
      <nav class="panel-tabs" aria-label="板块直达">
        <button type="button" class="panel-tab" data-panel-switch="projects">项目</button>
        <button type="button" class="panel-tab" data-panel-switch="articles">学习记录</button>
        <button type="button" class="panel-tab" data-panel-switch="about">关于我</button>
      </nav>
      <a class="panel-sub-link" href="/tags/">标签</a>
      <a class="panel-sub-link" href="/archive/">归档</a>
      <a class="panel-gh" href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a>
    </div>
  </div>

  <main id="main-content" class="hub-main">
    <div class="hub-shell" id="top">
      <section class="hub" data-spotlight aria-labelledby="hub-title">
        <div class="hero-grid" aria-hidden="true"></div>
        <div class="hero-glow" aria-hidden="true"></div>
        <HeroSpotlight />
        <div class="hub-inner container">
          <div class="hub-brand"><span class="brand-mark">SC</span><span>{SITE.name}</span><span class="hub-brand-tag">ENTRY / 00</span></div>
          <div class="hub-copy">
            <div class="eyebrow">个人技术博客 · NETWORK & CODE</div>
            <h1 id="hub-title" tabindex="-1">SmalL<span>Coat</span></h1>
            <p class="hub-tagline">以代码为笔，探索技术的无限可能。<br /><strong>记录编程实践，也记录网络安全学习的每一步。</strong></p>
            <nav class="hub-nav" aria-label="选择板块">
              {entries.map((entry) => (
                <a class="hub-entry" href={`#${entry.id}`} data-hub-link={entry.id}>
                  <span class="hub-entry-num">{entry.num}</span>
                  <span class="hub-entry-body"><strong>{entry.name}</strong><small>{entry.caption}</small></span>
                  <span class="hub-entry-arrow">→</span>
                </a>
              ))}
              <a class="hub-entry" href={SITE.github} target="_blank" rel="noreferrer">
                <span class="hub-entry-num">04</span>
                <span class="hub-entry-body"><strong>GitHub</strong><small>OPEN SOURCE · {SITE.handle}</small></span>
                <span class="hub-entry-arrow">↗</span>
              </a>
            </nav>
            <p class="hub-hint">选择板块进入 · 数字键 1–3 直达 · 按 ESC 返回入口</p>
          </div>
          <div class="hub-art"><TechIllustration /></div>
        </div>
      </section>
    </div>

    <div class="hub-panels">
      <section class="section hub-panel" id="projects" data-hub-panel="projects" data-hub-label="项目" data-spotlight hidden tabindex="-1" aria-label="项目">
        <HeroSpotlight />
        <div class="projects-stage">
          <div class="container">
            <div class="section-heading"><div><div class="section-kicker">Selected work / 01—03</div><h2 class="section-title">正在构建的东西</h2></div><div class="section-note">一些实践，也是一段段学习记录。</div></div>
            <div class="build-log" aria-hidden="true">
              <span class="build-log-tag">BUILD LOG</span>
              <div class="build-log-screen">
                <span class="build-log-line">$ ./build.sh SecGuard --target=host</span>
                <span class="build-log-line">[OK] SIEM 规则引擎编译通过 · 2.4s</span>
                <span class="build-log-line">$ python3 dengbao-assessment-practice --check=2.0</span>
                <span class="build-log-line">[OK] 等保 2.0 核查清单校验完成 · 100%</span>
                <span class="build-log-line">$ npm run build --workspace=AI_APP</span>
                <span class="build-log-line">[OK] smallcoat-blog · {posts.length} 篇学习记录已就绪</span>
              </div>
            </div>
            <div class="project-list">
              {PROJECTS.map((project) => (
                <a class="project" href={project.href} target="_blank" rel="noreferrer">
                  <div class="project-top"><span>PROJECT / {project.number}</span><span class="project-symbol">↗</span></div>
                  <h3 class="project-title">{project.name}</h3>
                  <p class="project-desc">{project.description}</p>
                  <span class="project-tag">{project.tech}</span>
                  <span class="project-open">查看 GitHub 项目 ↗</span>
                  <span class="project-arrow" set:html={arrow} />
                </a>
              ))}
            </div>
            <nav class="project-controls" aria-label="项目场景切换">
              <span class="project-position" aria-hidden="true">01 / 03</span>
              {PROJECTS.map((project, index) => <button type="button" data-project-index={index} aria-label={`展示项目 ${index + 1}`}><span>{project.number}</span> {project.name}</button>)}
              <a href="#about" class="skip-stage" data-hub-link="about">跳过展示 →</a>
            </nav>
          </div>
        </div>
      </section>

      <section class="section hub-panel" id="articles" data-hub-panel="articles" data-hub-label="学习记录" data-spotlight hidden tabindex="-1" aria-label="学习记录">
        <HeroSpotlight />
        <div class="container">
          <div class="decode-bar" aria-hidden="true"><span class="decode-prefix">&gt; DECRYPT</span><span class="decode-text" data-decode-text>LEARNING LOG · {posts.length} FILES · {activeWeeks.length} WEEKS · ACCESS GRANTED</span></div>

          <div class="articles-stats" aria-label="学习记录总览">
            <div class="as-metrics">
              <span><strong>{posts.length}</strong> 篇笔记</span>
              <span>·</span>
              <span>约 <strong>{(totalWords / 10000).toFixed(1)}</strong> 万字</span>
              <span>·</span>
              <span><strong>{totalImages}</strong> 张实战截图</span>
            </div>
            <div class="as-links">
              <a href="/tags/">标签索引 ({allTags.length}) ↗</a>
              <a href="/archive/">完整归档 ↗</a>
              <a href="/rss.xml">RSS ↗</a>
            </div>
          </div>

          <ArticleSearch />

          {latestPost && (
            <div class="articles-quick" data-articles-quick>
              <a class="aq-link" href={`/posts/${latestPost.id}/`} data-aq-link>
                <span class="aq-badge" data-aq-badge>最新笔记</span>
                <span class="aq-day" data-aq-day>{formatDayLabel(latestPost.id)}</span>
                <span class="aq-title" data-aq-title>{latestPost.data.title}</span>
                <span class="aq-arrow">→</span>
              </a>
            </div>
          )}

          <div class="section-heading"><div><div class="section-kicker">Learning log / Day 01—{String(posts.length).padStart(2, '0')}</div><h2 class="section-title"><button type="button" class="title-toggle" data-articles-gate aria-controls="week-list">网络安全实战学习记录</button></h2></div><div class="section-note">点击标题展开周目录 · {activeWeeks.length} 周 · {posts.length} 篇</div></div>
          <ArticlesFilter weeks={activeWeeks.map((group) => group.week)} />
          <div class="week-list" id="week-list" data-articles-weeks>
            {activeWeeks.map((group) => <section class="week-group" aria-labelledby={`week-${group.week}`}>
              <div class="week-heading"><span class="week-number">WEEK / 0{group.week}</span><h3 id={`week-${group.week}`}><button type="button" class="week-toggle" data-week-toggle aria-controls={`week-articles-${group.week}`}>{group.label}</button></h3><span class="week-count">{String(group.posts.length).padStart(2, '0')} 篇</span></div>
              <div class="article-list" id={`week-articles-${group.week}`} data-week-articles>
                {group.posts.map((post) => {
                  const stats = statsById.get(post.id)!;
                  const searchIndex = `${post.data.title} ${post.data.description} ${(post.data.tags ?? []).join(' ')} ${post.id} ${stats.h2Headings.join(' ')}`.toLowerCase();
                  return (
                    <a class="article-row" href={`/posts/${post.id}/`} data-week={group.week} data-search={searchIndex}>
                      <span class="article-day">{formatDayLabel(post.id)}</span>
                      <span class="article-main"><strong>{post.data.title}</strong><small>{post.data.description}</small></span>
                      <span class="article-arrow">↗</span>
                    </a>
                  );
                })}
              </div>
            </section>)}
          </div>
        </div>
      </section>

      <section class="section hub-panel" id="about" data-hub-panel="about" data-hub-label="关于我" data-spotlight hidden tabindex="-1" aria-label="关于我">
        <HeroSpotlight />
        <div class="container about">
          <div><div class="section-kicker">About / 你好</div><h2 class="about-title">关于我</h2>
            <div class="whoami-term" data-whoami aria-hidden="true">
              <div class="whoami-bar"><span class="whoami-dot"></span><span class="whoami-dot"></span><span class="whoami-dot"></span><span class="whoami-title">whoami — zsh</span></div>
              <div class="whoami-body">
                <p data-line><span class="whoami-prompt">$</span><span class="whoami-typed">whoami</span></p>
                <p data-line><span class="whoami-typed">{SITE.name} · 网络空间安全专业在读</span></p>
                <p data-line><span class="whoami-prompt">$</span><span class="whoami-typed">cat focus.txt</span></p>
                <p data-line><span class="whoami-typed">Python 深入中 · Web 安全 · CTF</span></p>
                <p data-line><span class="whoami-prompt">$</span><span class="whoami-typed">./status --now</span></p>
                <p data-line><span class="whoami-typed">[OK] 学习进度 Day {posts.length} / ∞ · 保持好奇</span></p>
              </div>
            </div>
          </div>
          <div class="about-copy">
            <p>你好，我是 <strong>{SITE.name}</strong>，一名网络空间安全专业的大学生。</p>
            <p>学习过 C、Java、PHP 和 Python，目前正在深入学习 Python。我会在这里记录编程实践与学习心得，分享网络安全方向的探索与成长。</p>

            <div class="about-skills" aria-label="技术栈与常用工具">
              {ABOUT_SKILLS.map((group) => (
                <div class="skill-group">
                  <span class="skill-label">{group.category}</span>
                  <div class="skill-pills">
                    {group.items.map((item) => <span class="skill-pill">{item}</span>)}
                  </div>
                </div>
              ))}
            </div>

            <div class="about-roadmap" aria-label="学习路线图">
              <h3 class="roadmap-title">安全实战路线（Week 01—06 · 持续更新）</h3>
              <div class="roadmap-list">
                {WEEK_META.map((item) => (
                  <div class="roadmap-item">
                    <span class="roadmap-week">WEEK 0{item.week}</span>
                    <div class="roadmap-body">
                      <strong>{item.label}</strong>
                      <small>{item.summary}</small>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <div class="about-links">
              <a class="text-link" href={SITE.github} target="_blank" rel="noreferrer">GITHUB / {SITE.handle} ↗</a>
              <a class="text-link" href="/tags/">标签索引 ↗</a>
              <a class="text-link" href="/archive/">完整归档 ↗</a>
              <a class="text-link" href="/rss.xml">RSS 订阅 ↗</a>
            </div>
          </div>
        </div>
      </section>
    </div>
  </main>

  <SiteFooter />
  <BackToTop />
  <CinematicScroll />
  <ScrollReveal />
  <ArticlesAccordion />
  <DecodeBar />
  <WhoamiTerminal />
  <HubController />

  <script>
    // 若存在本地最近阅读记录，将快捷卡片升级为「继续阅读」。
    try {
      const raw = localStorage.getItem('sc:last-read');
      if (raw) {
        const saved = JSON.parse(raw) as { slug?: string; title?: string; dayLabel?: string };
        const link = document.querySelector<HTMLAnchorElement>('[data-aq-link]');
        const badge = document.querySelector<HTMLElement>('[data-aq-badge]');
        const day = document.querySelector<HTMLElement>('[data-aq-day]');
        const title = document.querySelector<HTMLElement>('[data-aq-title]');
        if (saved.slug && saved.title && link && badge && title) {
          link.href = `/posts/${saved.slug}/`;
          badge.textContent = '继续阅读';
          if (day && saved.dayLabel) day.textContent = saved.dayLabel;
          title.textContent = saved.title;
        }
      }
    } catch {
      // 隐私模式或数据损坏时保留静态最新笔记。
    }
  </script>
</BaseLayout>
