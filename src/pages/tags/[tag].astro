---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import BackToTop from '../../components/BackToTop.astro';
import {
  estimateReadingStats,
  formatDate,
  formatDayLabel,
  getAllTags,
  getPublishedPosts,
  getTopicTags,
  tagToSlug,
  type TagInfo,
} from '../../lib/posts';
import { SITE } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPublishedPosts('asc');
  const allTags = getAllTags(posts);
  return allTags.map((tagInfo) => ({
    params: { tag: tagInfo.slug },
    props: { tagInfo, allTags },
  }));
}

interface Props {
  tagInfo: TagInfo;
  allTags: TagInfo[];
}

const { tagInfo, allTags } = Astro.props;
const otherTags = allTags.filter((item) => item.slug !== tagInfo.slug).slice(0, 12);
---
<BaseLayout
  title={`#${tagInfo.tag} 标签归档 — ${SITE.name}`}
  description={`标签「${tagInfo.tag}」下的 ${tagInfo.count} 篇学习记录与实战笔记。`}
>
  <SiteHeader active="tags" />

  <main class="subpage" id="main-content">
    <div class="container">
      <div class="subpage-console">
        <div class="subpage-nav-row">
          <a class="text-link" href="/tags/">← 全部标签</a>
          <span class="console-stat">TAG // {tagInfo.count} FILES</span>
        </div>

        <header class="subpage-head">
          <div class="section-kicker">Topic / 标签筛选</div>
          <h1 class="subpage-title">#{tagInfo.tag}</h1>
          <p class="subpage-desc">共找到 {tagInfo.count} 篇与「{tagInfo.tag}」相关的学习笔记。</p>
        </header>

        <section class="tag-post-list" aria-label="匹配文章列表">
          {tagInfo.posts.map((post) => {
            const stats = estimateReadingStats(post.body);
            const topicTags = getTopicTags(post);
            return (
              <article class="tag-post-card">
                <div class="tpc-meta">
                  <span class="tpc-day">{formatDayLabel(post.id)}</span>
                  <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
                  <span>·</span>
                  <span>约 {stats.minutes} 分钟</span>
                </div>
                <h2 class="tpc-title">
                  <a href={`/posts/${post.id}/`}>{post.data.title}</a>
                </h2>
                <p class="tpc-desc">{post.data.description}</p>
                <div class="tpc-tags">
                  {topicTags.map((tag) => (
                    <a
                      class={`tpc-tag ${tag === tagInfo.tag ? 'is-current' : ''}`}
                      href={`/tags/${tagToSlug(tag)}/`}
                    >
                      #{tag}
                    </a>
                  ))}
                </div>
              </article>
            );
          })}
        </section>

        {otherTags.length > 0 && (
          <section class="more-tags" aria-label="其他标签">
            <div class="section-kicker">Explore / 更多标签</div>
            <div class="more-tag-list">
              {otherTags.map((item) => (
                <a class="more-tag-chip" href={`/tags/${item.slug}/`}>
                  #{item.tag} <span>{item.count}</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    </div>
  </main>

  <SiteFooter />
  <BackToTop />

  <style>
    .subpage { min-height: calc(100svh - 135px); padding: 42px 0 76px; }
    .subpage-console {
      border: 1px solid var(--line);
      border-radius: 14px;
      background: linear-gradient(180deg, rgba(28, 18, 51, .52), rgba(28, 18, 51, .18));
      padding: clamp(20px, 3.5vw, 36px);
      box-shadow: inset 0 0 60px rgba(86, 217, 245, .03), 0 24px 60px rgba(0, 0, 0, .26);
    }
    .subpage-nav-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding-bottom: 14px;
      border-bottom: 1px solid var(--line);
    }
    .console-stat { color: var(--cyan); font: 500 11px var(--mono); letter-spacing: .12em; }
    .subpage-head { margin-top: 24px; }
    .subpage-title { margin: 10px 0 8px; font-size: clamp(28px, 4.5vw, 40px); letter-spacing: -.045em; color: var(--cyan); }
    .subpage-desc { margin: 0; color: var(--muted); font-size: 14.5px; }

    .tag-post-list {
      display: grid;
      gap: 14px;
      margin-top: 28px;
    }
    .tag-post-card {
      padding: 18px 20px;
      border: 1px solid var(--line);
      border-radius: 9px;
      background: rgba(21, 13, 38, .55);
      transition: border-color .18s;
    }
    .tag-post-card:hover { border-color: rgba(86, 217, 245, .42); }
    .tpc-meta {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 8px;
      color: var(--subtle);
      font: 11px var(--mono);
    }
    .tpc-day { color: var(--cyan); font-weight: 500; }
    .tpc-title { margin: 10px 0 8px; font-size: 18px; line-height: 1.45; letter-spacing: -.02em; }
    .tpc-title a { color: var(--text); }
    .tpc-title a:hover { color: var(--cyan); }
    .tpc-desc { margin: 0; color: var(--muted); font-size: 13.5px; line-height: 1.75; }
    .tpc-tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; }
    .tpc-tag {
      padding: 3px 9px;
      border: 1px solid var(--line);
      border-radius: 4px;
      color: #a5b8c8;
      font: 10.5px var(--mono);
    }
    .tpc-tag:hover,
    .tpc-tag.is-current {
      color: var(--cyan);
      border-color: rgba(86, 217, 245, .45);
      background: rgba(86, 217, 245, .07);
    }
    .more-tags {
      margin-top: 38px;
      padding-top: 26px;
      border-top: 1px solid var(--line);
    }
    .more-tag-list {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 14px;
    }
    .more-tag-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 36px;
      padding: 0 11px;
      border: 1px solid var(--line);
      border-radius: 5px;
      color: var(--muted);
      font: 11.5px var(--mono);
    }
    .more-tag-chip span { color: var(--cyan); }
    .more-tag-chip:hover { color: var(--cyan); border-color: rgba(86, 217, 245, .45); }
    .tpc-title a:focus-visible,
    .tpc-tag:focus-visible,
    .more-tag-chip:focus-visible {
      outline: 2px solid var(--cyan);
      outline-offset: 2px;
      border-radius: 4px;
    }
  </style>
</BaseLayout>
