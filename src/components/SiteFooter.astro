---
import { SITE } from '../lib/site';
---
<footer class="site-footer">
  <div class="container footer-inner">
    <span>© {new Date().getUTCFullYear()} {SITE.name}. Built with Astro.</span>
    <nav class="footer-links" aria-label="页脚导航">
      <a href="/tags/">标签</a>
      <a href="/archive/">归档</a>
      <a href="/rss.xml">RSS</a>
      <a href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a>
    </nav>
    <span class="footer-mark">STAY CURIOUS · KEEP BUILDING</span>
  </div>
</footer>

<style>
  .footer-links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    font: 11px var(--mono);
    color: var(--muted);
  }
  .footer-links a:hover {
    color: var(--cyan);
  }
  .footer-links a:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
    border-radius: 3px;
  }
</style>
