---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
  variant?: 'desktop' | 'mobile';
}

const { headings, variant = 'desktop' } = Astro.props;
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
---
{items.length > 0 && variant === 'desktop' && (
  <aside class="post-toc" aria-label="文章目录">
    <div class="toc-title">CONTENTS · {items.length}</div>
    <ol class="toc-list">
      {items.map((item) => (
        <li class={`toc-item depth-${item.depth}`}>
          <a href={`#${item.slug}`} data-toc-link={item.slug}>{item.text}</a>
        </li>
      ))}
    </ol>
  </aside>
)}

{items.length > 0 && variant === 'mobile' && (
  <details class="toc-mobile">
    <summary class="toc-mobile-summary">
      <span>目录</span>
      <span class="toc-mobile-count">{items.length} 节</span>
    </summary>
    <ol class="toc-list">
      {items.map((item) => (
        <li class={`toc-item depth-${item.depth}`}>
          <a href={`#${item.slug}`} data-toc-mobile-link={item.slug}>{item.text}</a>
        </li>
      ))}
    </ol>
  </details>
)}

<style>
  .post-toc {
    position: sticky;
    top: 82px;
    align-self: start;
    max-height: calc(100svh - 110px);
    overflow-y: auto;
    padding: 16px 16px 18px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: rgba(28, 18, 51, .42);
  }
  .toc-title {
    margin-bottom: 12px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--line);
    color: var(--cyan);
    font: 500 10px var(--mono);
    letter-spacing: .14em;
  }
  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 2px;
  }
  .toc-item a {
    display: block;
    padding: 6px 8px;
    border-left: 2px solid transparent;
    border-radius: 0 4px 4px 0;
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.5;
    transition: color .16s ease, border-color .16s ease, background .16s ease;
  }
  .toc-item.depth-3 a {
    padding-left: 18px;
    font-size: 11.5px;
    color: var(--subtle);
  }
  .toc-item a:hover {
    color: var(--text);
    background: rgba(86, 217, 245, .04);
  }
  .toc-item a.is-active,
  .toc-item a[aria-current="location"] {
    color: var(--cyan);
    border-left-color: var(--cyan);
    background: rgba(86, 217, 245, .07);
  }
  .toc-item a:focus-visible,
  .toc-mobile-summary:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 2px;
  }

  .toc-mobile {
    display: none;
    margin: 24px 0 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: rgba(28, 18, 51, .45);
  }
  .toc-mobile-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    padding: 0 16px;
    color: var(--text);
    font: 500 12.5px var(--mono);
    letter-spacing: .06em;
    cursor: pointer;
    list-style: none;
  }
  .toc-mobile-summary::-webkit-details-marker { display: none; }
  .toc-mobile-count {
    color: var(--cyan);
    font-size: 11px;
  }
  .toc-mobile .toc-list {
    padding: 6px 12px 14px;
    border-top: 1px solid var(--line);
  }

  @media (max-width: 1179px) {
    .post-toc { display: none; }
    .toc-mobile { display: block; }
  }
</style>

<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')];
  const mobileDetails = document.querySelector<HTMLDetailsElement>('.toc-mobile');
  const mobileLinks = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc-mobile-link]')];

  mobileLinks.forEach((link) => {
    link.addEventListener('click', () => {
      if (mobileDetails) mobileDetails.open = false;
    });
  });

  if (links.length && typeof IntersectionObserver === 'function') {
    const headings = links
      .map((link) => document.getElementById(link.dataset.tocLink || ''))
      .filter((el): el is HTMLElement => Boolean(el));

    const setActive = (id: string) => {
      links.forEach((link) => {
        const match = link.dataset.tocLink === id;
        link.classList.toggle('is-active', match);
        if (match) link.setAttribute('aria-current', 'location');
        else link.removeAttribute('aria-current');
      });
    };

    if (headings[0]) setActive(headings[0].id);

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (visible[0]) setActive(visible[0].target.id);
      },
      { rootMargin: '-80px 0px -68% 0px', threshold: 0 },
    );
    headings.forEach((heading) => observer.observe(heading));
  }
</script>
