---
import { SITE } from '../lib/site';

interface Props {
  active?: 'articles' | 'tags' | 'archive';
  showProgress?: boolean;
}

const { active, showProgress = false } = Astro.props;
---
<header class="site-header-bar">
  <div class="sh-inner container">
    <a class="sh-brand" href="/">
      <span class="brand-mark">SC</span>
      <span>{SITE.name}</span>
    </a>
    <nav class="sh-nav" aria-label="全站导航">
      <a class="sh-link sh-desktop" href="/#projects">项目</a>
      <a class="sh-link" href="/#articles" aria-current={active === 'articles' ? 'page' : undefined}>学习记录</a>
      <a class="sh-link" href="/tags/" aria-current={active === 'tags' ? 'page' : undefined}>标签</a>
      <a class="sh-link" href="/archive/" aria-current={active === 'archive' ? 'page' : undefined}>归档</a>
      <a class="sh-link sh-desktop" href="/#about">关于</a>
      <a class="sh-link sh-desktop" href="/rss.xml">RSS</a>
      <a class="sh-link sh-gh" href={SITE.github} target="_blank" rel="noreferrer">GitHub ↗</a>
    </nav>
  </div>
  {showProgress && (
    <div class="reading-progress" aria-hidden="true">
      <span class="reading-progress-bar" data-reading-progress></span>
    </div>
  )}
</header>

<style>
  .site-header-bar {
    position: sticky;
    top: 0;
    z-index: 30;
    height: 56px;
    background: rgba(21, 13, 38, .94);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .sh-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
  }
  .sh-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 14.5px;
    font-weight: 800;
    letter-spacing: -.04em;
    white-space: nowrap;
  }
  .sh-brand:focus-visible,
  .sh-link:focus-visible {
    outline: 2px solid var(--cyan);
    outline-offset: 3px;
    border-radius: 4px;
  }
  .sh-nav {
    display: flex;
    align-items: center;
    gap: 18px;
    min-width: 0;
  }
  .sh-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--muted);
    font: 500 12px var(--mono);
    letter-spacing: .04em;
    white-space: nowrap;
    transition: color .18s ease;
  }
  .sh-link:hover,
  .sh-link[aria-current="page"] {
    color: var(--cyan);
  }
  .sh-gh {
    color: var(--text);
  }
  .reading-progress {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    pointer-events: none;
    overflow: hidden;
  }
  .reading-progress-bar {
    display: block;
    width: 100%;
    height: 100%;
    background: linear-gradient(90deg, var(--cyan-strong), var(--cyan), #b9a8ff);
    transform: scaleX(0);
    transform-origin: left center;
    will-change: transform;
  }
  @media (max-width: 700px) {
    .sh-desktop { display: none; }
    .sh-nav { gap: 12px; }
    .sh-brand span:last-child { display: none; }
  }
</style>

{showProgress && (
  <script>
    const bar = document.querySelector<HTMLElement>('[data-reading-progress]');
    if (bar) {
      let frame = 0;
      const update = () => {
        frame = 0;
        const maxScroll = Math.max(1, document.documentElement.scrollHeight - window.innerHeight);
        const progress = Math.max(0, Math.min(1, window.scrollY / maxScroll));
        bar.style.transform = `scaleX(${progress.toFixed(4)})`;
      };
      const schedule = () => {
        if (!frame) frame = requestAnimationFrame(update);
      };
      window.addEventListener('scroll', schedule, { passive: true });
      window.addEventListener('resize', schedule, { passive: true });
      update();
    }
  </script>
)}
