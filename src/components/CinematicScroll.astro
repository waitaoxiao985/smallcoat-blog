---
import '../styles/cinematic.css';
---
<script>
  const root = document.documentElement;
  const projects = document.querySelector<HTMLElement>('#projects');
  const panels = projects ? [...projects.querySelectorAll<HTMLElement>('.project')] : [];
  const buttons = projects ? [...projects.querySelectorAll<HTMLButtonElement>('[data-project-index]')] : [];
  const counter = projects?.querySelector<HTMLElement>('.project-position');
  const media = matchMedia('(min-width: 1000px) and (min-height: 650px) and (prefers-reduced-motion: no-preference)');
  const clamp = (value: number) => Math.max(0, Math.min(1, value));
  let frame = 0;

  function render() {
    frame = 0;
    if (!media.matches || !projects) return;
    const progress = clamp(-projects.getBoundingClientRect().top / Math.max(1, projects.offsetHeight - innerHeight));
    const position = progress * (panels.length - 1);
    const active = Math.round(position);
    panels.forEach((panel, index) => {
      const distance = index - position;
      const isActive = index === active;
      panel.dataset.active = String(isActive);
      panel.inert = !isActive;
      panel.style.opacity = String(clamp(1 - Math.abs(distance) * 1.3));
      panel.style.transform = `perspective(1100px) translate3d(${distance * 95}px,${distance * 48}px,${-Math.abs(distance) * 180}px) rotateX(${distance * -8}deg) scale(${1 - Math.min(1, Math.abs(distance)) * .12})`;
      panel.style.visibility = Math.abs(distance) > 1 ? 'hidden' : 'visible';
    });
    buttons.forEach((button, index) => button.setAttribute('aria-pressed', String(index === active)));
    if (counter) counter.textContent = `${String(active + 1).padStart(2, '0')} / ${String(panels.length).padStart(2, '0')}`;
    projects.style.setProperty('--scene-progress', String(progress));
  }

  function schedule() {
    if (media.matches && !frame) frame = requestAnimationFrame(render);
  }

  function configure() {
    cancelAnimationFrame(frame);
    frame = 0;
    if (media.matches && projects) {
      root.dataset.cinematic = 'true';
      render();
    } else {
      root.removeAttribute('data-cinematic');
      panels.forEach(panel => {
        panel.inert = false;
        panel.removeAttribute('data-active');
        ['opacity', 'transform', 'visibility'].forEach(property => panel.style.removeProperty(property));
      });
    }
  }
  buttons.forEach((button, index) => button.addEventListener('click', () => {
    if (!projects) return;
    const top = projects.getBoundingClientRect().top + scrollY;
    window.scrollTo({ top: top + (projects.offsetHeight - innerHeight) * index / Math.max(1, panels.length - 1), behavior: 'instant' });
    schedule();
  }));
  window.addEventListener('scroll', schedule, { passive: true });
  window.addEventListener('resize', schedule, { passive: true });
  window.addEventListener('pageshow', schedule);
  window.addEventListener('hub:panelchange', () => { configure(); schedule(); });
  media.addEventListener('change', configure);
  configure();
</script>
